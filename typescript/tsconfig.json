{
  "include": ["src/**/*.ts", "interfaces/**/*.ts", "wit.d.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types"],
    "target": "ES2023",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      // "wit": ["wit.js"]
      // "ts-typescript-system-typescript-system": ["interfaces/ts-typescript-system-typescript-system.d.ts"]
    }
  }
}
