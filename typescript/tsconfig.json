{
  "include": ["src/**/*.ts", "interfaces/**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    // "outDir": "./",
    "typeRoots": ["./node_modules/@types"],
    "target": "ES2023",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
    //   "wasi-filesystem-preopens": ["interfaces/wasi-filesystem-preopens.d.ts"]
      "ts-typescript-system-ts": ["interfaces/ts-typescript-system-ts.d.ts"]
    }
  }
}
