package ts:typescript@0.1.0;

interface typescript {
    use ts:typescript-system/types@0.1.0.{system};

    set-sys: func(sys: system);

    resource compiler-options {
      new: static func() -> compiler-options;
      get-always-strict: func() -> option<bool>;
      set-always-strict: func(value: option<bool>);
      // set-target: func(value: option<script-target>);
    }

    resource program {
      get-type-checker: func() -> type-checker;
    }

    version: func() -> string;

    create-compiler-host: func(compiler-options: borrow<compiler-options>, set-parent-nodes: bool) -> compiler-host;

    // create-program: func(root-names: list<string>, options: compiler-options) -> result<program, string>;
    // create-program: func(options: compiler-options) -> result<program, string>;
    create-program: func() -> result<program, string>;

    get-pre-emit-diagnostics: func(program: borrow<program>) -> list<diagnostic>;

    resource type-checker {
    }

    resource compiler-host {
    }

    resource diagnostic {
    }
}

world root {
  import ts:typescript-system/types@0.1.0;

  // to satisfy jco componentize
  import wasi:io/poll@0.2.2;
  
  export typescript;
}
