// https://component-model.bytecodealliance.org/design/wit.html

package local:cowsay;

world cowsay {
  export test: func() -> string;
  export canvas: interface {
    ts-version: func() -> string;
    resource compiler-options {
      constructor();
      inner: func() -> u8;
      // set_inner: func(string) -> void;
      get-always-strict: func() -> option<bool>;
      set-always-strict: func(value: option<bool>);
    }
    // resource bundle {
    //   constructor();
    //   kind: func() -> u8;
    // }
    node-factory: func() -> nodefactory;
    resource nodefactory {
      create-void-zero: func() -> voidexpression;
    }
    resource voidexpression {
      // kind: func() -> u8;
      kind: func() -> syntax-kind;
    }
    // bigger becuase 371
    type syntax-kind = u16;
  }
}
