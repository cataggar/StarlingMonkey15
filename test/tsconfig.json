{
  // "include": ["src/**/*.ts", "../typescript/dist/**/*.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "moduleResolution": "node",
    // "outDir": "./",
    "target": "ES2023",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "cowsay": ["../typescript/dist/cowsay.d.ts"],
    },
    "baseUrl": "."
  }
}
